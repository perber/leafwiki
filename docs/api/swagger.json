{
    "swagger": "2.0",
    "info": {
        "description": "Development API of LeafWiki. This documentation is incomplete, experimental and may change before v1; only a few operations are described so far.\nAPI keys (Bearer authentication) are available only when LeafWiki runs with `--enable-api-key-management` and authentication enabled. Existing browser API routes are not newly hidden behind that flag.\nBrowser sessions use the access and refresh cookies (`__Host-leafwiki_at` and `__Host-leafwiki_rt` on secure connections, unprefixed names for allowed insecure development). Session writes are protected by CSRF double-submit: send the `X-CSRF-Token` header matching the CSRF cookie (the `csrf_token` form field is accepted as a fallback).\nThe documented base path is the default mount. A deployment started with `--base-path=/wiki` prepends `/wiki` to every documented URL.",
        "title": "LeafWiki API",
        "contact": {},
        "license": {
            "name": "MIT",
            "url": "https://github.com/perber/leafwiki/blob/main/LICENSE"
        },
        "version": "0.x"
    },
    "basePath": "/api",
    "paths": {
        "/health": {
            "get": {
                "description": "Public liveness and readiness probe; no authentication is required and session cookies are never validated. Global middleware can still reject a request before the handler runs: 401 for an invalid, revoked or expired API key (only when API-key management is enabled) or for an identity asserted by a trusted reverse proxy that LeafWiki rejects (only when reverse-proxy authentication is enabled), and 429 when API-key attempts are throttled.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "health"
                ],
                "summary": "Check instance health",
                "responses": {
                    "200": {
                        "description": "All checks passed (ongoing search indexing still counts as healthy)",
                        "schema": {
                            "$ref": "#/definitions/health.HealthResponse"
                        }
                    },
                    "401": {
                        "description": "Invalid, revoked or expired API key (when API-key management is enabled), or a rejected trusted-proxy identity: unknown user or auto-provisioning email conflict (when reverse-proxy authentication is enabled)",
                        "schema": {
                            "$ref": "#/definitions/dto.LegacyError"
                        }
                    },
                    "429": {
                        "description": "API-key attempts throttled",
                        "schema": {
                            "$ref": "#/definitions/dto.LegacyError"
                        }
                    },
                    "503": {
                        "description": "Degraded: the body is a HealthResponse with failed checks. If API-key resolution cannot reach its store, the body is a LegacyError instead. Swagger 2.0 cannot express this alternative, so the schema is a broad object.",
                        "schema": {
                            "type": "object"
                        }
                    }
                }
            }
        },
        "/links/broken": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Lists every link in the wiki whose target page does not exist, with the page it appears on.\nAccess: admin only, also when public access is on. API keys act with the lesser of the owner's role and the key's role. With authentication disabled the route answers 403.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "links"
                ],
                "summary": "List broken links",
                "responses": {
                    "200": {
                        "description": "Broken links; an empty list when there are none",
                        "schema": {
                            "$ref": "#/definitions/dto.BrokenLinks"
                        }
                    },
                    "401": {
                        "description": "No valid session, an invalid, revoked or expired API key (when API-key management is enabled), or a rejected trusted-proxy identity (when reverse-proxy authentication is enabled)",
                        "schema": {
                            "$ref": "#/definitions/dto.LegacyError"
                        }
                    },
                    "403": {
                        "description": "The caller is not an admin, or authentication is disabled",
                        "schema": {
                            "$ref": "#/definitions/dto.LegacyError"
                        }
                    },
                    "429": {
                        "description": "API-key attempts throttled",
                        "schema": {
                            "$ref": "#/definitions/dto.LegacyError"
                        }
                    },
                    "500": {
                        "description": "Link lookup failed: the body is an ErrorResponse (code link_internal_error). Authentication middleware failures return a LegacyError instead. Swagger 2.0 cannot express this alternative, so the schema is a broad object.",
                        "schema": {
                            "type": "object"
                        }
                    },
                    "503": {
                        "description": "API-key store unavailable during a live restore (when API-key management is enabled)",
                        "schema": {
                            "$ref": "#/definitions/dto.LegacyError"
                        }
                    }
                }
            }
        },
        "/pages/{id}/links": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Lists the links pointing at the given page (backlinks) and, separately, the links from other pages to this page's path that are broken (broken incoming links). The links starting on the page are split the same way into outgoing and broken outgoing links. The counters hold the length of each of the four lists.\nAccess: a signed-in user (session cookie, API key or reverse-proxy identity); anonymous callers only when public access is on. With public access on, a missing or invalid session cookie is treated as anonymous instead of 401.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "links"
                ],
                "summary": "Get link status of a page",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Page ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Link status of the page; empty lists for a page without links",
                        "schema": {
                            "$ref": "#/definitions/dto.LinkStatus"
                        }
                    },
                    "401": {
                        "description": "No valid session while public access is off, an invalid, revoked or expired API key (when API-key management is enabled), or a rejected trusted-proxy identity (when reverse-proxy authentication is enabled)",
                        "schema": {
                            "$ref": "#/definitions/dto.LegacyError"
                        }
                    },
                    "404": {
                        "description": "No page with this ID (code link_page_not_found)",
                        "schema": {
                            "$ref": "#/definitions/dto.ErrorResponse"
                        }
                    },
                    "429": {
                        "description": "API-key attempts throttled",
                        "schema": {
                            "$ref": "#/definitions/dto.LegacyError"
                        }
                    },
                    "500": {
                        "description": "Link lookup failed: the body is an ErrorResponse (code link_internal_error). Authentication middleware failures return a LegacyError instead. Swagger 2.0 cannot express this alternative, so the schema is a broad object.",
                        "schema": {
                            "type": "object"
                        }
                    },
                    "503": {
                        "description": "API-key store unavailable during a live restore (when API-key management is enabled)",
                        "schema": {
                            "$ref": "#/definitions/dto.LegacyError"
                        }
                    }
                }
            }
        },
        "/properties": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Lists the frontmatter property keys with the number of pages carrying each, ordered by count (descending), then by key. Nested properties use dot-joined keys such as `a.b`.\nAccess: a signed-in user (session cookie, API key or reverse-proxy identity); anonymous callers only when public access is on. With public access on, a missing or invalid session cookie is treated as anonymous instead of 401.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "properties"
                ],
                "summary": "List property keys",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Prefix filter on the key; trimmed and lowercased before matching",
                        "name": "q",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "default": 50,
                        "description": "Maximum number of keys; values below 1 mean 50, values above 200 mean 200",
                        "name": "limit",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Keys with page counts; empty array when nothing matches",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/dto.PropertyKeyCount"
                            }
                        }
                    },
                    "400": {
                        "description": "limit is not an integer (code properties_invalid_limit)",
                        "schema": {
                            "$ref": "#/definitions/dto.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "No valid session while public access is off, an invalid, revoked or expired API key (when API-key management is enabled), or a rejected trusted-proxy identity (when reverse-proxy authentication is enabled)",
                        "schema": {
                            "$ref": "#/definitions/dto.LegacyError"
                        }
                    },
                    "429": {
                        "description": "API-key attempts throttled",
                        "schema": {
                            "$ref": "#/definitions/dto.LegacyError"
                        }
                    },
                    "500": {
                        "description": "Index lookup failed: the body is an ErrorResponse (code properties_internal_error). Authentication middleware failures return a LegacyError instead. Swagger 2.0 cannot express this alternative, so the schema is a broad object.",
                        "schema": {
                            "type": "object"
                        }
                    },
                    "503": {
                        "description": "API-key store unavailable during a live restore (when API-key management is enabled)",
                        "schema": {
                            "$ref": "#/definitions/dto.LegacyError"
                        }
                    }
                }
            }
        },
        "/properties/pages": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Lists the pages whose property `key` has exactly the value `value`. Key and value are matched as given (not trimmed or lowercased); each must contain a non-space character.\nAccess: a signed-in user (session cookie, API key or reverse-proxy identity); anonymous callers only when public access is on. With public access on, a missing or invalid session cookie is treated as anonymous instead of 401.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "properties"
                ],
                "summary": "List pages by property",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Property key, for example `status` or a dot-joined nested key",
                        "name": "key",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Exact property value",
                        "name": "value",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Matching pages with all their properties; empty array when none match",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/dto.PropertyPage"
                            }
                        }
                    },
                    "400": {
                        "description": "key or value is missing or blank (code properties_missing_key or properties_missing_value)",
                        "schema": {
                            "$ref": "#/definitions/dto.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "No valid session while public access is off, an invalid, revoked or expired API key (when API-key management is enabled), or a rejected trusted-proxy identity (when reverse-proxy authentication is enabled)",
                        "schema": {
                            "$ref": "#/definitions/dto.LegacyError"
                        }
                    },
                    "429": {
                        "description": "API-key attempts throttled",
                        "schema": {
                            "$ref": "#/definitions/dto.LegacyError"
                        }
                    },
                    "500": {
                        "description": "Index lookup failed: the body is an ErrorResponse (code properties_internal_error). Authentication middleware failures return a LegacyError instead. Swagger 2.0 cannot express this alternative, so the schema is a broad object.",
                        "schema": {
                            "type": "object"
                        }
                    },
                    "503": {
                        "description": "API-key store unavailable during a live restore (when API-key management is enabled)",
                        "schema": {
                            "$ref": "#/definitions/dto.LegacyError"
                        }
                    }
                }
            }
        },
        "/search": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Full-text search over page titles and content, or a tag-only listing when `tags` is given without `q`. With both, the text hits are filtered to pages carrying every given tag. Each hit carries a rank and an excerpt; the result also lists the tags of the matching pages as facets. `limit` and `offset` are handed to the text index as they are (no upper bound, `-1` means all rows); a tag-only search turns a `limit` below 1 into 20 and clamps a negative `offset`.\nAccess: a signed-in user (session cookie, API key or reverse-proxy identity); anonymous callers only when public access is on. With public access on, a missing or invalid session cookie is treated as anonymous instead of 401.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "search"
                ],
                "summary": "Search pages",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Search text; required unless `tags` is given",
                        "name": "q",
                        "in": "query"
                    },
                    {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "collectionFormat": "multi",
                        "description": "Tags a page must all carry; repeat the parameter or separate tags with commas",
                        "name": "tags",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "default": 0,
                        "description": "Number of hits to skip",
                        "name": "offset",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "default": 20,
                        "description": "Maximum number of hits",
                        "name": "limit",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Hits and tag facets; empty lists when nothing matches",
                        "schema": {
                            "$ref": "#/definitions/dto.SearchResult"
                        }
                    },
                    "400": {
                        "description": "Neither `q` nor a tag given (code search_missing_query), or `offset` or `limit` is not an integer (codes search_invalid_offset, search_invalid_limit)",
                        "schema": {
                            "$ref": "#/definitions/dto.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "No valid session while public access is off, an invalid, revoked or expired API key (when API-key management is enabled), or a rejected trusted-proxy identity (when reverse-proxy authentication is enabled)",
                        "schema": {
                            "$ref": "#/definitions/dto.LegacyError"
                        }
                    },
                    "429": {
                        "description": "API-key attempts throttled",
                        "schema": {
                            "$ref": "#/definitions/dto.LegacyError"
                        }
                    },
                    "500": {
                        "description": "Index lookup failed: the body is an ErrorResponse (code search_internal_error). Authentication middleware failures return a LegacyError instead. Swagger 2.0 cannot express this alternative, so the schema is a broad object.",
                        "schema": {
                            "type": "object"
                        }
                    },
                    "503": {
                        "description": "API-key store unavailable during a live restore (when API-key management is enabled)",
                        "schema": {
                            "$ref": "#/definitions/dto.LegacyError"
                        }
                    }
                }
            }
        },
        "/search/status": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Reports whether the search index is being (re)built, how many pages were indexed and how many failed in the current or last run, and when the last run finished. `finished_at` is `0001-01-01T00:00:00Z` until the first run has finished.\nAccess: a signed-in user (session cookie, API key or reverse-proxy identity); anonymous callers only when public access is on. With public access on, a missing or invalid session cookie is treated as anonymous instead of 401.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "search"
                ],
                "summary": "Get search indexing status",
                "responses": {
                    "200": {
                        "description": "Current indexing status",
                        "schema": {
                            "$ref": "#/definitions/dto.IndexingStatus"
                        }
                    },
                    "401": {
                        "description": "No valid session while public access is off, an invalid, revoked or expired API key (when API-key management is enabled), or a rejected trusted-proxy identity (when reverse-proxy authentication is enabled)",
                        "schema": {
                            "$ref": "#/definitions/dto.LegacyError"
                        }
                    },
                    "429": {
                        "description": "API-key attempts throttled",
                        "schema": {
                            "$ref": "#/definitions/dto.LegacyError"
                        }
                    },
                    "500": {
                        "description": "Authentication middleware failure; the handler itself cannot fail",
                        "schema": {
                            "$ref": "#/definitions/dto.LegacyError"
                        }
                    },
                    "503": {
                        "description": "API-key store unavailable during a live restore (when API-key management is enabled)",
                        "schema": {
                            "$ref": "#/definitions/dto.LegacyError"
                        }
                    }
                }
            }
        },
        "/tags": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Lists tags with the number of pages carrying each, ordered by count (descending), then by tag. With `selected`, only pages carrying every selected tag are counted and the selected tags themselves are left out, so the result is the tags that can narrow the selection further.\nAccess: a signed-in user (session cookie, API key or reverse-proxy identity); anonymous callers only when public access is on. With public access on, a missing or invalid session cookie is treated as anonymous instead of 401.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "tags"
                ],
                "summary": "List tags",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Prefix filter on the tag name; trimmed and lowercased before matching",
                        "name": "q",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "default": 50,
                        "description": "Maximum number of tags; values below 1 mean 50, values above 200 mean 200",
                        "name": "limit",
                        "in": "query"
                    },
                    {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "collectionFormat": "multi",
                        "description": "Already selected tags; repeat the parameter or separate tags with commas",
                        "name": "selected",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Tags with page counts; empty array when nothing matches",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/dto.TagCount"
                            }
                        }
                    },
                    "400": {
                        "description": "limit is not an integer (code tags_invalid_limit)",
                        "schema": {
                            "$ref": "#/definitions/dto.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "No valid session while public access is off, an invalid, revoked or expired API key (when API-key management is enabled), or a rejected trusted-proxy identity (when reverse-proxy authentication is enabled)",
                        "schema": {
                            "$ref": "#/definitions/dto.LegacyError"
                        }
                    },
                    "429": {
                        "description": "API-key attempts throttled",
                        "schema": {
                            "$ref": "#/definitions/dto.LegacyError"
                        }
                    },
                    "500": {
                        "description": "Index lookup failed: the body is an ErrorResponse (code tags_internal_error). Authentication middleware failures return a LegacyError instead. Swagger 2.0 cannot express this alternative, so the schema is a broad object.",
                        "schema": {
                            "type": "object"
                        }
                    },
                    "503": {
                        "description": "API-key store unavailable during a live restore (when API-key management is enabled)",
                        "schema": {
                            "$ref": "#/definitions/dto.LegacyError"
                        }
                    }
                }
            }
        },
        "/tags/pages": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Lists the pages that carry every given tag. Tags are trimmed and lowercased before matching.\nAccess: a signed-in user (session cookie, API key or reverse-proxy identity); anonymous callers only when public access is on. With public access on, a missing or invalid session cookie is treated as anonymous instead of 401.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "tags"
                ],
                "summary": "List pages by tags",
                "parameters": [
                    {
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "collectionFormat": "multi",
                        "description": "Tags a page must all carry; repeat the parameter or separate tags with commas",
                        "name": "tags",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Matching pages; empty array when none match",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/dto.TaggedPage"
                            }
                        }
                    },
                    "400": {
                        "description": "No non-empty tag given (code tags_missing_param)",
                        "schema": {
                            "$ref": "#/definitions/dto.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "No valid session while public access is off, an invalid, revoked or expired API key (when API-key management is enabled), or a rejected trusted-proxy identity (when reverse-proxy authentication is enabled)",
                        "schema": {
                            "$ref": "#/definitions/dto.LegacyError"
                        }
                    },
                    "429": {
                        "description": "API-key attempts throttled",
                        "schema": {
                            "$ref": "#/definitions/dto.LegacyError"
                        }
                    },
                    "500": {
                        "description": "Index lookup failed: the body is an ErrorResponse (code tags_internal_error). Authentication middleware failures return a LegacyError instead. Swagger 2.0 cannot express this alternative, so the schema is a broad object.",
                        "schema": {
                            "type": "object"
                        }
                    },
                    "503": {
                        "description": "API-key store unavailable during a live restore (when API-key management is enabled)",
                        "schema": {
                            "$ref": "#/definitions/dto.LegacyError"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "dto.Backlink": {
            "type": "object",
            "required": [
                "broken",
                "from_page_id",
                "from_path",
                "from_title",
                "to_page_id"
            ],
            "properties": {
                "broken": {
                    "type": "boolean"
                },
                "from_page_id": {
                    "type": "string"
                },
                "from_path": {
                    "type": "string"
                },
                "from_title": {
                    "type": "string"
                },
                "to_page_id": {
                    "type": "string"
                }
            }
        },
        "dto.BrokenLink": {
            "type": "object",
            "required": [
                "from_page_id",
                "from_path",
                "from_title",
                "to_path"
            ],
            "properties": {
                "from_page_id": {
                    "type": "string"
                },
                "from_path": {
                    "type": "string"
                },
                "from_title": {
                    "type": "string"
                },
                "to_path": {
                    "type": "string"
                }
            }
        },
        "dto.BrokenLinks": {
            "type": "object",
            "required": [
                "links"
            ],
            "properties": {
                "links": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/dto.BrokenLink"
                    }
                }
            }
        },
        "dto.ErrorDetail": {
            "type": "object",
            "required": [
                "code",
                "message",
                "template"
            ],
            "properties": {
                "args": {
                    "description": "Args are the values substituted into Template; omitted when empty.",
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "code": {
                    "description": "Code is the stable machine-readable error code, e.g. \"page_not_found\".",
                    "type": "string"
                },
                "message": {
                    "description": "Message is the English human-readable message.",
                    "type": "string"
                },
                "template": {
                    "description": "Template is the localization key the client translates; it doubles as\nthe fallback message when no translation exists.",
                    "type": "string"
                }
            }
        },
        "dto.ErrorResponse": {
            "type": "object",
            "required": [
                "error"
            ],
            "properties": {
                "error": {
                    "description": "Error carries the localizable error details.",
                    "allOf": [
                        {
                            "$ref": "#/definitions/dto.ErrorDetail"
                        }
                    ]
                }
            }
        },
        "dto.IndexingStatus": {
            "type": "object",
            "required": [
                "active",
                "failed",
                "finished_at",
                "indexed"
            ],
            "properties": {
                "active": {
                    "type": "boolean"
                },
                "failed": {
                    "type": "integer"
                },
                "finished_at": {
                    "type": "string"
                },
                "indexed": {
                    "type": "integer"
                }
            }
        },
        "dto.LegacyError": {
            "type": "object",
            "required": [
                "error"
            ],
            "properties": {
                "error": {
                    "description": "Error is the human-readable error message.",
                    "type": "string"
                }
            }
        },
        "dto.LinkStatus": {
            "type": "object",
            "required": [
                "backlinks",
                "broken_incoming",
                "broken_outgoings",
                "counts",
                "outgoings"
            ],
            "properties": {
                "backlinks": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/dto.Backlink"
                    }
                },
                "broken_incoming": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/dto.Backlink"
                    }
                },
                "broken_outgoings": {
